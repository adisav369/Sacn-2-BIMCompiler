<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.bim</groupId>
        <artifactId>bim-compiler-parent</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>dag-compiler</artifactId>
    <packaging>jar</packaging>

    <name>DAG Compiler</name>
    <description>BIM Intent Compiler — DSL parser, DAG builder, geometry engine</description>

    <dependencies>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.choco-solver</groupId>
            <artifactId>choco-solver</artifactId>
        </dependency>
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Phase 4c: ORM layer — X_AdBomChild, X_AdProductDim etc. for GPD dispatch -->
        <dependency>
            <groupId>com.bim</groupId>
            <artifactId>orm-sandbox</artifactId>
        </dependency>
        <!-- BIMEyes: geometric comprehension engine (Phase 1) -->
        <dependency>
            <groupId>com.bim</groupId>
            <artifactId>bim-eyes</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <!-- Contract tests run on every build — not optional.
                 Two ordered executions enforce the compilation→validation chain:
                   1. compile-buildings: BuildingRegistryTest compiles all buildings,
                      writes output DBs to DAGCompiler/lib/output/.
                   2. validate-contracts: StructuralCrossCheckTest + all other tests
                      read the DBs written in step 1.
                 Maven aborts after step 1 on any failure, so cross-checks can never
                 silently pass against stale or missing compiled DBs. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <!-- Forward CLI -D properties to the forked JVM.
                     Shell passes: -Dbom.db=... -Ddoc.base.type=...
                     Without this, System.getProperty() returns null in tests. -->
                <configuration>
                    <systemPropertyVariables>
                        <bom.db>${bom.db}</bom.db>
                        <doc.base.type>${doc.base.type}</doc.base.type>
                        <bim.log.level>${bim.log.level}</bim.log.level>
                    </systemPropertyVariables>
                </configuration>
                <executions>
                    <!-- Disable the default-test execution; we replace it below -->
                    <execution>
                        <id>default-test</id>
                        <phase>test</phase>
                        <goals><goal>test</goal></goals>
                        <configuration>
                            <skip>true</skip>
                        </configuration>
                    </execution>
                    <!-- Step 1: compile all buildings, write output DBs -->
                    <execution>
                        <id>compile-buildings</id>
                        <phase>test</phase>
                        <goals><goal>test</goal></goals>
                        <configuration>
                            <includes>
                                <include>**/contract/BuildingRegistryTest.java</include>
                            </includes>
                            <workingDirectory>${project.parent.basedir}</workingDirectory>
                        </configuration>
                    </execution>
                    <!-- Step 2: cross-checks and all other validations -->
                    <execution>
                        <id>validate-contracts</id>
                        <phase>test</phase>
                        <goals><goal>test</goal></goals>
                        <configuration>
                            <includes>
                                <include>**/contract/*Test.java</include>
                                <include>**/contract/*Tests.java</include>
                                <include>**/arch/*Test.java</include>
                                <include>**/coordinate/*Test.java</include>
                                <include>**/library/*Test.java</include>
                            </includes>
                            <excludes>
                                <!-- Already ran in step 1 -->
                                <exclude>**/contract/BuildingRegistryTest.java</exclude>
                            </excludes>
                            <workingDirectory>${project.parent.basedir}</workingDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <configuration>
                    <!-- Critical: run from project root so relative paths
                         (config/, output/, library/) resolve correctly -->
                    <workingDirectory>${project.parent.basedir}</workingDirectory>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
