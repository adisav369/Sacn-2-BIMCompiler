  "proof_render": {
    "_note": "Controls DXF\u2192SVG proof renderer. Separation of concern: DXF layers are for CAD software, proof_render controls what the human sees.",
    "skip_entity_types": [
      "HATCH"
    ],
    "_skip_hatch_reason": "HATCH = DXF fill for CAD viewers. LWPOLYLINE on A-WALL-PATT already provides fill=black in SVG. HATCH duplicates geometry and adds visual noise.",
    "skip_layers": [
      "A-WALL-FULL",
      "A-WALL-PRTN"
    ],
    "_skip_wall_layers_reason": "A-WALL-FULL and A-WALL-PRTN are outline-only polygons. A-WALL-PATT provides fill=black+stroke=black \u2014 one polygon per wall. Skipping outline layers removes 30+ duplicate fill=none polygons that cause blurry/heavy edges.",
    "furniture_fill": "#F0F0F0",
    "_furniture_fill_reason": "Match reference: furniture as light gray filled rectangles with gray stroke. Reference archive has 14 F0F0F0 fills for furniture.",
    "wall_fill_layer": "A-WALL-PATT",
    "_wall_fill_layer_reason": "The canonical wall fill layer. Proof renderer uses fill=#000000 + stroke=#000000 on this layer only.",
    "bold_text_min_height_mm": 3.0,
    "_bold_text_reason": "Text with paper-height >= this value renders as font-weight=bold. Applies to drawing title (4.5mm), room labels (3.5mm), title block values (3.0mm). Labels and dim text (2.0-2.5mm) stay normal."
  }
