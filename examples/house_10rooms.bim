BUILDING "scale_test" {
    STOREY "Ground" level:0 height:2.8m {
        LIVING "living" size:6x5m {
            exterior: south
        }
        LIVING "dining" size:4x4m {
            adjacent: living
        }
        KITCHEN "kitchen" size:4x3m {
            adjacent: dining
            not_adjacent: bedroom1
        }
        BEDROOM "bedroom1" size:4x4m {
            exterior: north
        }
        BEDROOM "bedroom2" size:4x3m {
            adjacent: bedroom1
        }
        BEDROOM "bedroom3" size:3x3m {
            exterior: east
        }
        BATHROOM "bath1" size:2x3m {
            adjacent: bedroom1
        }
        BATHROOM "bath2" size:2x2m {
            adjacent: bedroom2
            adjacent: bedroom3
        }
        OFFICE "study" size:3x3m {
            not_adjacent: kitchen
        }
        CORRIDOR "hall" size:6x2m {
            adjacent: living
            adjacent: bedroom1
        }
    }
    ROOF pitch:15deg
}
