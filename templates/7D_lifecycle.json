    "IfcFlowTreatmentDevice":   {"lifespan_years": 10, "warranty_months": 12, "service_interval_months":  3, "note": "Filter replacement quarterly"},
    "IfcFlowMovingDevice":      {"lifespan_years": 15, "warranty_months": 24, "service_interval_months":  3, "note": "Pump/fan quarterly service"},
    "IfcFlowStorageDevice":     {"lifespan_years": 25, "warranty_months": 12, "service_interval_months": 12, "note": "Tank inspection yearly"},

    "IfcLightFixture":          {"lifespan_years":  8, "warranty_months": 24, "service_interval_months": 12, "note": "LED driver replacement ~8yr"},
