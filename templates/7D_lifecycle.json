    "IfcBeam":                  {"lifespan_years": 50, "warranty_months": 12, "service_interval_months": 60, "note": "Steel beam — coating check 5yr"},
    "IfcMember":                {"lifespan_years": 40, "warranty_months": 12, "service_interval_months": 60, "note": "Structural member"},
    "IfcWall":                  {"lifespan_years": 50, "warranty_months": 12, "service_interval_months": 24, "note": "Blockwork — repaint 2yr"},
